{
  "name": "@kazuni/sdk",
  "version": "0.5.2",
  "description": "Official JavaScript/TypeScript SDK for the Kazuni notifications API",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.6.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazunihq/kazuni-js.git"
  },
  "bugs": {
    "url": "https://github.com/kazunihq/kazuni-js/issues"
  },
  "homepage": "https://github.com/kazunihq/kazuni-js#readme",
  "keywords": ["kazuni", "email", "sdk", "notifications", "api"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check .",
    "docs": "typedoc",
    "test:integration": "vitest run test/integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
